DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
# GUILD_ID=your_original_server_id_if_migrating_old_commands
DATA_FILE=./data/state.json
# On Render, set DATABASE_URL to your private Neon Postgres connection string.
# DATABASE_URL=postgresql://.../neondb?sslmode=require
# Website sign-in: OAuth2 Client Secret from Discord Developer Portal
DISCORD_CLIENT_SECRET=your_oauth_client_secret
# Public URL of this same Render Web Service, with no trailing slash
PUBLIC_URL=https://ironclad-bot.onrender.com
# One stable web-push key pair; generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
